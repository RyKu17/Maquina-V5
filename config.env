# ============================================
# Configuracion de Maquina-V5 (Cloud Gaming)
# ============================================

# --- Sunshine Web UI ---
SUNSHINE_USER="admin"
SUNSHINE_PASS="admin"

# --- Tailscale ---
# Opcional: dejar vacio para modo interactivo
TAILSCALE_AUTHKEY=""

# --- Display Virtual ---
DISPLAY_RES="1920x1080"
DISPLAY_REFRESH="60"

# --- Google Drive ---
MOUNT_DRIVE="false"
BACKUP_ENABLED="false"

# --- Region Colab (auto, us-central1, europe-west4, etc) ---
REGION_PREF="auto"
